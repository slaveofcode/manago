---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import SlackIntegration from "@/components/integrations/SlackIntegration.svelte";
import TelegramIntegration from "@/components/integrations/TelegramIntegration.svelte";
import RocketChatIntegration from "@/components/integrations/RocketChatIntegration.svelte";
import EmailIntegration from "@/components/integrations/EmailIntegration.svelte";

// Mark this page as server-rendered (not prerendered/static)
export const prerender = false;

// Redirect if user is not logged in
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

// Get the integration type from query params (default to slack)
const integrationType = Astro.url.searchParams.get('type') || 'slack';
---

<DashboardLayout title="Add Integration">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight">Add Integration</h1>
      <a 
        href="/dashboard/integrations" 
        class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
      >
        Back to Integrations
      </a>
    </div>
    
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="p-6">
        <h2 class="text-lg font-medium mb-4">Select Integration Type</h2>
        
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 mb-8">
          <a 
            href="/dashboard/integrations/add?type=slack" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'slack' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5z"></path>
                <path d="M20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"></path>
                <path d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5z"></path>
                <path d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14z"></path>
                <path d="M14 14.5c0-.83.67-1.5 1.5-1.5h5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-5c-.83 0-1.5-.67-1.5-1.5z"></path>
                <path d="M15.5 19H14v1.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5z"></path>
                <path d="M10 9.5C10 8.67 9.33 8 8.5 8h-5C2.67 8 2 8.67 2 9.5S2.67 11 3.5 11h5c.83 0 1.5-.67 1.5-1.5z"></path>
                <path d="M8.5 5H10V3.5C10 2.67 9.33 2 8.5 2S7 2.67 7 3.5 7.67 5 8.5 5z"></path>
              </svg>
            </div>
            <div class="font-medium">Slack</div>
            <div class="text-xs text-muted-foreground text-center">Send notifications to Slack channels</div>
          </a>
          
          <a 
            href="/dashboard/integrations/add?type=telegram" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'telegram' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 4.5 2.5 12.5 9.5 13.5 17.5 8.5 10.5 15.5 17.5 19.5 21.5 4.5"></path>
                <path d="M9.5 13.5 9.5 19.5 12.5 16.5"></path>
              </svg>
            </div>
            <div class="font-medium">Telegram</div>
            <div class="text-xs text-muted-foreground text-center">Send notifications to Telegram channels (Coming Soon)</div>
          </a>
          
          <a 
            href="/dashboard/integrations/add?type=rocketchat" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'rocketchat' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 0 0 5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 1 0 5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M12 2v8"></path>
                <path d="M4.2 10.2 12 14l7.8-3.8a4 4 0 0 0 0-6.4l-7.8-3.8-7.8 3.8a4 4 0 0 0 0 6.4Z"></path>
              </svg>
            </div>
            <div class="font-medium">Rocket.Chat</div>
            <div class="text-xs text-muted-foreground text-center">Send notifications to Rocket.Chat channels (Coming Soon)</div>
          </a>
          
          <a 
            href="/dashboard/integrations/add?type=email" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'email' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div class="font-medium">Email</div>
            <div class="text-xs text-muted-foreground text-center">Send email notifications (Coming Soon)</div>
          </a>
          
          <a 
            href="/dashboard/integrations/add?type=twitter" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'twitter' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
              </svg>
            </div>
            <div class="font-medium">X (Twitter)</div>
            <div class="text-xs text-muted-foreground text-center">Post updates to X/Twitter (Coming Soon)</div>
          </a>
          
          <a 
            href="/dashboard/integrations/add?type=github" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'github' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
            </div>
            <div class="font-medium">GitHub</div>
            <div class="text-xs text-muted-foreground text-center">Connect with GitHub repositories (Coming Soon)</div>
          </a>
          
          <a 
            href="/dashboard/integrations/add?type=gitlab" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'gitlab' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m22 13.29-3.33-10a.42.42 0 0 0-.14-.18.38.38 0 0 0-.22-.11.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18l-2.26 6.67H8.32L6.1 3.26a.42.42 0 0 0-.1-.18.38.38 0 0 0-.26-.08.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18L2 13.29a.74.74 0 0 0 .27.83L12 21l9.69-6.88a.71.71 0 0 0 .31-.83Z"></path>
              </svg>
            </div>
            <div class="font-medium">GitLab</div>
            <div class="text-xs text-muted-foreground text-center">Connect with GitLab repositories (Coming Soon)</div>
          </a>
          
          <a 
            href="/dashboard/integrations/add?type=google" 
            class={`flex flex-col items-center p-4 border rounded-md hover:border-primary ${integrationType === 'google' ? 'border-primary bg-primary/5' : 'border-input'}`}
          >
            <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M17.13 17.21c-.95.3-1.87.44-3.13.44-3.64 0-5.88-2.36-5.88-5.7 0-3.15 2.42-5.7 5.83-5.7 3.23 0 5.37 2.14 5.37 4.93 0 .34-.04 1.16-.08 1.27H11.5v1.18h3.13c-.15.52-1.05 1.54-2.4 1.54-1.52 0-2.77-1.18-2.77-2.7 0-1.54 1.26-2.77 2.77-2.77.78 0 1.31.34 1.62.64l.97-.97c-.78-.74-1.83-1.15-2.9-1.15-2.4 0-4.34 1.94-4.34 4.34 0 2.4 1.94 4.34 4.34 4.34 2.32 0 4.2-1.54 4.2-3.8 0-.34-.04-.67-.08-.97h-4.12"></path>
              </svg>
            </div>
            <div class="font-medium">Google</div>
            <div class="text-xs text-muted-foreground text-center">Enable Google SSO login (Coming Soon)</div>
          </a>
        </div>
        
        {integrationType === 'slack' && (
          <div>
            <h3 class="text-lg font-medium mb-4">Configure Slack Integration</h3>
            <SlackIntegration client:load />
          </div>
        )}
        
        {integrationType === 'telegram' && (
          <div>
            <h3 class="text-lg font-medium mb-4">Configure Telegram Integration</h3>
            <div class="bg-amber-50 text-amber-600 p-3 rounded-md mb-4">
              <p class="font-medium">Coming Soon</p>
              <p class="text-sm">This integration is currently in development and will be available soon.</p>
            </div>
            <TelegramIntegration client:load />
          </div>
        )}
        
        {integrationType === 'rocketchat' && (
          <div>
            <h3 class="text-lg font-medium mb-4">Configure Rocket.Chat Integration</h3>
            <div class="bg-amber-50 text-amber-600 p-3 rounded-md mb-4">
              <p class="font-medium">Coming Soon</p>
              <p class="text-sm">This integration is currently in development and will be available soon.</p>
            </div>
            <RocketChatIntegration client:load />
          </div>
        )}
        
        {integrationType === 'email' && (
          <div>
            <h3 class="text-lg font-medium mb-4">Configure Email Integration</h3>
            <div class="bg-amber-50 text-amber-600 p-3 rounded-md mb-4">
              <p class="font-medium">Coming Soon</p>
              <p class="text-sm">This integration is currently in development and will be available soon.</p>
            </div>
            <EmailIntegration client:load />
          </div>
        )}
        
        {(integrationType !== 'slack' && 
          integrationType !== 'telegram' && 
          integrationType !== 'rocketchat' && 
          integrationType !== 'email') && (
          <div class="text-center py-8">
            <p class="text-muted-foreground">This integration is not yet available.</p>
            <a 
              href="/dashboard/integrations" 
              class="mt-4 inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
            >
              Back to Integrations
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</DashboardLayout>