---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import IntegrationsManager from "@/components/integrations/IntegrationsManager.svelte";

// Mark this page as server-rendered (not prerendered/static)
export const prerender = false;

// Redirect if user is not logged in
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

// Import integration model
const { getUserIntegrations } = await import('../../../lib/models/integration.js');

// Get integrations for the current user
const integrations = await getUserIntegrations(Astro.locals.user.id);
---

<DashboardLayout title="Integrations">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight">Integrations</h1>
    </div>
    
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="p-6">
        <h2 class="text-lg font-medium mb-4">Manage App Integrations</h2>
        <p class="text-muted-foreground mb-6">
          Connect Manago with your favorite apps and services to enhance your workflow.
        </p>
        
        <IntegrationsManager 
          client:load 
          initialIntegrations={integrations} 
          userId={Astro.locals.user.id}
        />
      </div>
    </div>
  </div>
</DashboardLayout>